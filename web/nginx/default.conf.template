# Rendered at container start by the official nginx image (envsubst).
#   PORT                  Railway's public port
#   AGENT_URL             private URL of the agent service, e.g. http://agent.railway.internal:8000
#   NGINX_LOCAL_RESOLVERS filled by the image from /etc/resolv.conf (NGINX_ENTRYPOINT_LOCAL_RESOLVERS=1)

server {
    listen ${PORT};
    listen [::]:${PORT};
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # Resolve the agent's private hostname per request so nginx starts even if the agent is not up yet.
    resolver ${NGINX_LOCAL_RESOLVERS} valid=10s ipv6=on;
    set $agent ${AGENT_URL};

    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    add_header X-Robots-Tag "noindex, nofollow" always;

    client_max_body_size 256k;

    # REST routes used by the UI
    location /api/ {
        proxy_pass $agent;
        proxy_http_version 1.1;
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 60s;
    }

    # The only Hayhooks route exposed publicly: streaming chat completions
    location = /v1/chat/completions {
        limit_except POST { deny all; }
        proxy_pass $agent;
        proxy_http_version 1.1;
        proxy_set_header Host $proxy_host;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 300s;
        chunked_transfer_encoding on;
    }

    # Everything else under /v1 (and the LLM shim) stays private
    location /v1/ { return 404; }
    location /llm-shim/ { return 404; }

    location /assets/ {
        expires 7d;
        try_files $uri =404;
    }

    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-cache" always;
        add_header X-Content-Type-Options nosniff always;
        add_header X-Frame-Options DENY always;
    }
}
